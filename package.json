{
	"name": "@hyperapi/driver-ipc",
	"version": "0.3.0-dev",
	"description": "HyperAPI driver for inter-process communication.",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "dist/main.js",
	"exports": {
		".": {
			"types": {
				"import": "./dist/main.d.ts",
				"require": "./dist/main.d.cts"
			},
			"import": "./dist/main.js",
			"require": "./dist/main.cjs"
		}
	},
	"engines": {
		"node": ">=21"
	},
	"peerDependencies": {
		"@hyperapi/core": "git+https://github.com/hyperapi/core#3d1898caa28e0cbc55c978f33bd9edf5a836337a"
	},
	"devDependencies": {
		"@biomejs/biome": "2.1.1",
		"@kirick/lint": "0.2.8",
		"@types/bun": "^1.2",
		"eslint": "9.27.0",
		"oxlint": "1.3.0",
		"publint": "0.3.12",
		"tsdown": "0.14.2",
		"typescript": "5.9.2",
		"unplugin-unused": "0.5.2",
		"vitest": "3.2.4"
	},
	"scripts": {
		"build": "tsdown src/main.ts --publint --unused --dts --format esm --format cjs",
		"check": "bun run lint && bun run build && bun run test",
		"lint": "biome format && oxlint && eslint . && tsc",
		"test": "npm run test:vitest && bun test --coverage",
		"test:vitest": "rm -r dist/vitest ; tsc -p tsconfig.test.json && vitest run --no-file-parallelism ; rm -r dist/vitest"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hyperapi/driver-ipc.git"
	},
	"keywords": [],
	"author": "Daniil Kirichenko (https://twitter.com/kirickme)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/hyperapi/driver-ipc/issues"
	},
	"homepage": "https://github.com/hyperapi/driver-ipc#readme"
}
