{
	"name": "@hyperapi/driver-ipc",
	"version": "0.3.0-dev",
	"description": "HyperAPI driver for inter-process communication.",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "dist/main.js",
	"types": "dist/main.d.ts",
	"exports": {
		".": {
			"import": "./dist/main.js",
			"require": "./dist/main.cjs"
		}
	},
	"engines": {
		"node": ">=21"
	},
	"peerDependencies": {
		"@hyperapi/core": "git+https://github.com/hyperapi/core#db67a3835ca465679c93a20c759759ba23535723"
	},
	"devDependencies": {
		"@kirick/eslint-config": "latest",
		"@types/bun": "^1.1.6",
		"eslint": "9.10.0",
		"publint": "0.3.12",
		"tsdown": "0.12.2",
		"typescript": "5.8.3",
		"unplugin-unused": "0.5.0",
		"vitest": "3.1.4"
	},
	"scripts": {
		"build": "tsdown src/main.ts --publint --unused --dts --format esm --format cjs && rm dist/main.d.cts",
		"check": "bun run lint && bun run build && bun run test",
		"lint": "eslint . && tsc",
		"test": "npm run test:vitest && bun test --coverage",
		"test:vitest": "rm -r dist/vitest ; tsc -p tsconfig.test.json && vitest run --no-file-parallelism ; rm -r dist/vitest"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hyperapi/driver-ipc.git"
	},
	"keywords": [],
	"author": "Daniil Kirichenko (https://twitter.com/kirickme)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/hyperapi/driver-ipc/issues"
	},
	"homepage": "https://github.com/hyperapi/driver-ipc#readme"
}
