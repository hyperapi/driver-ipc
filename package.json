{
	"name": "@hyperapi/driver-ipc",
	"version": "0.7.0-dev",
	"description": "HyperAPI driver for inter-process communication.",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"files": [
		"dist/"
	],
	"exports": {
		".": {
			"types": {
				"import": "./dist/main.d.mts",
				"require": "./dist/main.d.cts"
			},
			"import": "./dist/main.mjs",
			"require": "./dist/main.cjs"
		}
	},
	"engines": {
		"node": ">=21"
	},
	"peerDependencies": {
		"@hyperapi/core": "github:hyperapi/core#daac5df164cba7ce5f2638afef5dc13659d4f1c0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@kirick/lint": "0.4.2",
		"@types/bun": "1.4.2",
		"eslint": "10.7.0",
		"oxlint": "1.74.0",
		"publint": "0.3.21",
		"tsdown": "0.22.3",
		"typescript": "6.0.3",
		"unplugin-unused": "0.5.7",
		"valibot": "1.5.0",
		"vitest": "5.0.5"
	},
	"_devpack": {
		"@hyperapi/core": "../core"
	},
	"scripts": {
		"build": "tsdown src/main.ts --clean --dts --format esm --format cjs --unused --publint",
		"check": "lint && bun run test && bun run build",
		"test": "bun test && npm run test:vitest",
		"test:vitest": "tsc -p tsconfig.test.json --noEmit false --outDir node_modules/.vitest-build && vitest run --dir node_modules/.vitest-build --no-file-parallelism"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hyperapi/driver-ipc.git"
	},
	"keywords": [],
	"author": "Daniil Kirichenko (https://twitter.com/kirickme)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/hyperapi/driver-ipc/issues"
	},
	"homepage": "https://github.com/hyperapi/driver-ipc#readme"
}
