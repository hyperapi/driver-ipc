{
	"name": "@hyperapi/driver-ipc",
	"version": "0.6.0-dev",
	"description": "HyperAPI driver for inter-process communication.",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "dist/main.js",
	"exports": {
		".": {
			"types": {
				"import": "./dist/main.d.ts",
				"require": "./dist/main.d.cts"
			},
			"import": "./dist/main.js",
			"require": "./dist/main.cjs"
		}
	},
	"engines": {
		"node": ">=21"
	},
	"peerDependencies": {
		"@hyperapi/core": "github:hyperapi/core#d3ebe406e7b366e37e307a713de5a7898fe5858d"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.10",
		"@kirick/lint": "0.3.1",
		"@types/bun": "1.3.11",
		"eslint": "10.2.0",
		"oxlint": "1.58.0",
		"publint": "0.3.21",
		"tsdown": "0.15.12",
		"typescript": "6.0.2",
		"unplugin-unused": "0.5.4",
		"valibot": "1.4.0",
		"vitest": "4.1.7"
	},
	"scripts": {
		"build": "tsdown src/main.ts --clean --tsconfig tsconfig.main.json --publint --unused --dts --format esm --format cjs",
		"check": "bun run lint && bun run build && bun run test",
		"lint": "biome format && oxlint && eslint . && tsc -b",
		"test": "npm run test:vitest && bun test --coverage",
		"test:vitest": "rm -r dist/vitest ; tsc -p tsconfig.test.json && vitest run --dir dist/vitest --no-file-parallelism ; rm -r dist/vitest"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hyperapi/driver-ipc.git"
	},
	"keywords": [],
	"author": "Daniil Kirichenko (https://twitter.com/kirickme)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/hyperapi/driver-ipc/issues"
	},
	"homepage": "https://github.com/hyperapi/driver-ipc#readme"
}
